rules_version = '2';

// =============================================================================
// Firebase Storage — tenant isolation by GHL Location ID.
//
// Every object lives under /{locationId}/..., and a user may only touch the
// prefix matching the `location_id` custom claim on their ID token. A
// super_admin may reach any prefix.
//
// The claim is minted server-side by the Admin SDK, so it cannot be forged by
// the client — this is the same tenant key the API and database use.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ---- helpers ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isSuperAdmin() {
      return isSignedIn() && claims().role == 'super_admin';
    }

    // The caller's token belongs to this school.
    function belongsToLocation(locationId) {
      return isSignedIn() && claims().location_id == locationId;
    }

    function hasRole(roles) {
      return isSignedIn() && claims().role in roles;
    }

    // Staff roles that may manage a school's files.
    function isSchoolStaff() {
      return hasRole([
        'school_admin', 'principal', 'vice_principal', 'coordinator',
        'teacher', 'hr_manager', 'accountant', 'marketing'
      ]);
    }

    // 10 MB cap on general uploads; keeps a runaway client from filling the bucket.
    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ---- a user's own profile files --------------------------------------
    // Anyone may manage files under their own UID within their school.

    match /{locationId}/users/{userId}/{allPaths=**} {
      allow read: if belongsToLocation(locationId) || isSuperAdmin();
      allow write: if isSuperAdmin()
                   || (belongsToLocation(locationId)
                       && request.auth.uid == userId
                       && isReasonableSize());
    }

    // ---- school branding (logos, letterheads) ----------------------------
    // Readable by the whole school; writable by school administrators only.

    match /{locationId}/branding/{allPaths=**} {
      allow read: if belongsToLocation(locationId) || isSuperAdmin();
      allow write: if isSuperAdmin()
                   || (belongsToLocation(locationId)
                       && hasRole(['school_admin', 'principal', 'marketing'])
                       && isReasonableSize());
    }

    // ---- everything else under a school ----------------------------------
    // Documents, student records, assignment uploads, and so on.

    match /{locationId}/{allPaths=**} {
      allow read: if belongsToLocation(locationId) || isSuperAdmin();
      allow write: if isSuperAdmin()
                   || (belongsToLocation(locationId)
                       && isSchoolStaff()
                       && isReasonableSize());
    }

    // ---- default deny -----------------------------------------------------
    // Any path not under a locationId prefix is unreachable.

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
