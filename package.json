{
  "name": "sms-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS School Management System for Pakistani schools. Tenant identity = GHL Location ID.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "hash-password": "node scripts/hash-password.mjs",
    "check-super-admin": "node scripts/check-super-admin-env.mjs",
    "fingerprint": "node scripts/fingerprint.mjs",
    "smtp-encode": "node scripts/smtp-encode.mjs",
    "smoke-test": "node scripts/smoke-test-live.mjs",
    "check-theme": "esbuild scripts/check-theme-contrast.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-theme.mjs --log-level=warning && node node_modules/.cache/check-theme.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check-reports": "esbuild scripts/check-reports.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-shim.mjs --outfile=node_modules/.cache/check-reports.mjs --log-level=warning && node node_modules/.cache/check-reports.mjs",
    "check-dashboard": "esbuild scripts/check-dashboard-queries.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-shim.mjs --outfile=node_modules/.cache/check-dashboard.mjs --log-level=warning && node node_modules/.cache/check-dashboard.mjs",
    "check-portals": "esbuild scripts/check-portals.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-shim.mjs --outfile=node_modules/.cache/check-portals.mjs --log-level=warning && node node_modules/.cache/check-portals.mjs",
    "check-forms": "esbuild scripts/check-forms.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-forms.mjs --log-level=warning --jsx=automatic && node node_modules/.cache/check-forms.mjs",
    "check-address-phone": "esbuild scripts/check-address-phone.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-address-phone.mjs --log-level=warning && node node_modules/.cache/check-address-phone.mjs",
    "check-sprint-periods": "esbuild scripts/check-sprint-periods.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-shim.mjs --outfile=node_modules/.cache/check-sprint-periods.mjs --log-level=warning && node node_modules/.cache/check-sprint-periods.mjs",
    "check-accounting": "esbuild scripts/check-accounting.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-accounting.mjs --log-level=warning && node node_modules/.cache/check-accounting.mjs",
    "check-cnic": "esbuild scripts/check-cnic.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-cnic.mjs --log-level=warning && node node_modules/.cache/check-cnic.mjs",
    "check-loaders": "esbuild scripts/check-loaders.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-loaders.mjs --log-level=warning && node node_modules/.cache/check-loaders.mjs",
    "check-smtp": "esbuild scripts/check-smtp-credentials.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/check-smtp.mjs --log-level=warning && node node_modules/.cache/check-smtp.mjs",
    "check-provisioning": "esbuild scripts/check-provisioning.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./scripts/server-only-shim.mjs --outfile=node_modules/.cache/check-provisioning.mjs --log-level=warning && node node_modules/.cache/check-provisioning.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "jose": "^6.2.5",
    "lucide-react": "^1.31.0",
    "next": "^15.5.4",
    "node-vibrant": "^4.0.4",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ]
}
