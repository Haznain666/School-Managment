# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# production
build/
dist/

# env — never commit these. A committed .env.local is loaded by @next/env at
# server start and OVERWRITES platform-injected variables (Vercel, Docker, CI),
# so an empty one silently blanks every secret. Use .env.example as the template.
.env
.env.production
.env*.local

# firebase
.firebase/
firebase-debug.log
*-debug.log
serviceAccountKey.json

# vercel
.vercel

# editor / os
.DS_Store
Thumbs.db
.idea/

# Claude Code. `launch.json` is shared — it is how the dev server is started.
# `worktrees/` holds live git worktrees and must never be committed: it would
# nest a checkout inside its own repository.
.claude/worktrees/
.claude/settings.local.json
