# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# production
#
# ANCHORED, and it matters. A bare `build/` matches a directory named `build`
# at ANY depth — including `app/api/internal/build/`, which is an App Router
# segment, not build output. That route is the deploy's own "which commit is
# live" probe: it was written on 2026-08-21, has never been committed, and
# therefore 404'd on production while every local check passed. The deploy
# workflow's verification step depended on it and could never have succeeded.
#
# The leading slash pins both rules to the repository root, which is the only
# place either of these tools actually writes.
/build/
/dist/

# env — never commit these. A committed .env.local is loaded by @next/env at
# server start and OVERWRITES host-injected variables (the hosting panel, CI),
# so an empty one silently blanks every secret. Use .env.example as the template.
.env
.env.production
.env*.local

# firebase
.firebase/
firebase-debug.log
*-debug.log
serviceAccountKey.json

# editor / os
.DS_Store
Thumbs.db
.idea/

# Claude Code. `launch.json` is shared — it is how the dev server is started.
# `worktrees/` holds live git worktrees and must never be committed: it would
# nest a checkout inside its own repository.
.claude/worktrees/
.claude/settings.local.json
.playwright-mcp/
