# =============================================================================
# SMS Platform — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication — Supabase Auth (GoTrue).
#
# Sign-in is email + password; signup and password reset send a six-digit code
# that GoTrue generates, delivers, expires and rate-limits. There is no
# passcode table in this application and no password-verification code.
#
# Before this works, in the Supabase dashboard:
#   Authentication -> Providers -> Email  : enabled, "Confirm email" ON
#   Authentication -> Emails              : configure SMTP, or codes will not
#                                           be delivered beyond Supabase's very
#                                           low built-in sending limit
#   Authentication -> Sessions            : set the refresh-token lifetime; the
#                                           application does not own it
#
# The URL and the service-role key are the same pair Storage already uses,
# below — one Supabase project serves auth, database and files.
# -----------------------------------------------------------------------------
# Anon (publishable) key. Safe in the browser by design: it grants nothing on
# its own. Supabase -> Project Settings -> API keys -> anon / publishable.
# It is read at BUILD time, so set it before building, not after.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# File storage — Supabase Storage.
#
# Files were the first thing to move off Firebase, because Firebase Storage
# needed the paid Blaze plan. Auth and the database followed; Supabase is now
# the only backend vendor.
#
# Create the bucket first: Supabase -> Storage -> New bucket. Tick PUBLIC —
# a school logo has to load on the sign-in page, before anyone has
# authenticated.
# -----------------------------------------------------------------------------
# Project URL. Supabase -> Project Settings -> Data API -> Project URL.
# Format: https://<project-ref>.supabase.co   (https, no trailing slash)
SUPABASE_URL=
# Supabase -> Project Settings -> API keys -> service_role. NOT the anon key.
# Server-only: this bypasses every Storage policy, so it must never be given a
# NEXT_PUBLIC_ prefix, which would inline it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name exactly as created. Defaults to "school-assets" when unset, which
# is the bucket this project actually has. It previously defaulted to
# "school-files" — a name no bucket has ever had — so every logo upload failed
# with a bare "HTTP 400" and the Branding tab was unusable. Set this only if
# your bucket is named something else.
SUPABASE_STORAGE_BUCKET=school-assets

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL.
#
# Supabase -> Project Settings -> Database -> Connection string.
#
# For the APPLICATION use the **Transaction pooler** (port 6543). It multiplexes
# many short-lived clients onto few backend connections, which is what keeps a
# busy app from exhausting Postgres' connection slots.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# For MIGRATIONS (`npm run db:migrate`) use the **Session pooler** (port 5432 on
# the *pooler* host): DDL and advisory locks need one stable session, which
# transaction pooling cannot promise.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# NOT the direct connection (`db.<ref>.supabase.co`). Supabase serves that over
# IPv6 only unless the paid IPv4 add-on is enabled, so on a typical IPv4 network
# it fails with `getaddrinfo ENOTFOUND` — which reads like a wrong hostname or a
# paused project and is neither. Both pooler endpoints are IPv4-reachable.
#
# Note: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above are also required by the
# app itself, not just Storage — middleware resolves the tenant through the
# Supabase REST API, because it runs on the Edge where TCP is unavailable.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Apex domain that school subdomains hang off, e.g. platform.com
# `beaconhouse.platform.com` -> subdomain "beaconhouse".
NEXT_PUBLIC_APP_DOMAIN=platform.com
# Optional. In local development there is no real subdomain, so middleware falls
# back to this location_id. Leave blank in production.
DEV_FALLBACK_LOCATION_ID=

# -----------------------------------------------------------------------------
# GoHighLevel (GHL) — OAuth app credentials.
# Marketplace -> My Apps -> your app -> Settings.
# The GHL Location ID of a sub-account is this platform's tenant identifier.
# -----------------------------------------------------------------------------
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the GHL marketplace app.
GHL_REDIRECT_URI=
# Override only if GHL changes their API host.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL API version header value (they pin behaviour by date).
GHL_API_VERSION=2021-07-28

# -----------------------------------------------------------------------------
# Encryption — AES-256-GCM key used to encrypt GHL tokens at rest.
# Must be 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored GHL token (schools must re-connect).
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Super Admin — the platform operator account.
# This is a single credential, entirely separate from Supabase Auth: the Super
# Admin works across every school and so has no tenant of their own.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
# bcrypt hash of the password. From the project root:
#   node scripts/hash-password.mjs        (or: npm run hash-password)
# Use the node form on Windows PowerShell — the default execution policy
# refuses to load npm.ps1, and node.exe is not a script so it is unaffected.
# It prompts (so the password never reaches shell history) and prints this
# whole line back, already escaped.
#
# The escaping is not optional. @next/env runs dotenv-expand over this file, so
# every `$` in a bcrypt hash must be written `\$` inside double quotes:
#   SUPER_ADMIN_PASSWORD_HASH="\$2b\$12\$abc..."
# An unescaped hash is read as variable references, silently becomes something
# else, and every sign-in returns 401 with nothing in the log to explain it.
SUPER_ADMIN_PASSWORD_HASH=
# Secret used to sign the 8-hour session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPER_ADMIN_JWT_SECRET=

# Optional, and normally UNSET. Enables POST /api/internal/super-admin-check,
# which reports what the *deployed* process holds: the pid serving the request,
# the configured email, the hash's length/prefix/fingerprint, which .env files
# sit beside the server, and whether bcrypt accepts a given password there. It
# returns no hash, no secret and no password.
#
# It exists because every other way of checking a deployment reads some other
# process — a dev server, an SSH session, a script with its own environment —
# and none of those can prove anything about the one answering requests.
#
# It is a login oracle, so it refuses everything while this is blank, which is
# its correct resting state. Set it to debug, then unset it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SUPER_ADMIN_DIAGNOSTICS_SECRET=

# -----------------------------------------------------------------------------
# School portals (Sprint 3)
# One Supabase project serves every school. Tenants are separated by the
# subdomain the request arrives on and by the `school_users` row it selects —
# never by anything inside the credential.
# -----------------------------------------------------------------------------
# Apex domain that school subdomains hang off, e.g. beaconhouse.platform.com
PLATFORM_BASE_DOMAIN=platform.com
# Origin used to build invite links. In development this is your local origin.
INVITE_LINK_BASE_URL=https://platform.com

# Name of the session cookie for the school portals. @supabase/ssr owns its
# contents and may chunk it across `<name>.0`, `<name>.1`; the stem is this.
# The lifetime is GoTrue's, set in Authentication -> Sessions, not here.
SCHOOL_SESSION_COOKIE_NAME=school_session

# -----------------------------------------------------------------------------
# GoHighLevel — agency-level key, used to send WhatsApp invitations.
# Broader than the per-school OAuth tokens above, because an invite may need to
# go out before a school has completed its own GHL install.
# -----------------------------------------------------------------------------
GHL_AGENCY_API_KEY=
GHL_WHATSAPP_INVITE_TEMPLATE=staff_invite

# -----------------------------------------------------------------------------
# Admissions (Sprint 4)
# -----------------------------------------------------------------------------
# Optional. GHL workflow triggered for the primary guardian when a student is
# enrolled. Leave blank to skip it — enrolment never depends on the workflow,
# and a missing id is logged rather than treated as an error.
GHL_ADMISSION_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# SMTP — everything the application sends in its own voice: invitations, the
# invite passcode, sign-in instructions, fee notices.
#
# Separate from the SMTP configured in the Supabase dashboard, which GoTrue
# uses for its own sign-in codes. The two never see each other's credentials,
# so a working Supabase setup does not mean this one works.
#
# Leave SMTP_HOST or SMTP_FROM blank to disable application email entirely.
#
# ⚠ SMTP_PORT is worth setting explicitly. 465 is implicit TLS; 587 upgrades
# via STARTTLS. Measured against smtp.titan.email from a Pakistani ISP:
# 465 connected in 1.4s, 587 took 111s — the same message arrives either way,
# but on 587 the operator watches a spinner for two minutes first. If sending
# feels hung rather than broken, try 465 before suspecting credentials.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Email outbox drain (Sprint 0).
#
# Nothing sends mail inside a request any more: callers write to `email_outbox`
# and a drainer hands rows to SMTP outside the request, which is what removed
# the ~103-second spinner the note above describes. On Hostinger a single
# long-lived Node process runs that drainer on an interval and NOTHING BELOW IS
# REQUIRED for it to work.
#
# This secret exists for the day that is not enough — a host cron, an uptime
# pinger, or a second machine driving the same queue through
# `POST /api/internal/email/drain` with the value in an `x-drain-secret`
# header. Leave it blank and that route refuses every caller, which is the
# correct default: an unauthenticated endpoint that makes the server send mail
# is how a domain gets blacklisted.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------
EMAIL_DRAIN_SECRET=

# One-time passcodes sent over WhatsApp. Codes are six digits, so the expiry
# and attempt cap are what keep them safe — do not raise them casually.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
