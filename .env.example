# =============================================================================
# SMS Platform — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — CLIENT SDK (browser). These are safe to expose publicly; access is
# controlled by Firebase Security Rules + custom claims, not by these values.
# Find them in: Firebase Console -> Project settings -> Your apps -> Web app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database instance URL, e.g. https://<project>-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Firebase — ADMIN SDK (server only). From a service account JSON key:
# Firebase Console -> Project settings -> Service accounts -> Generate new key.
# NEVER prefix these with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# The full PEM private key. Keep the literal "\n" escapes on one line, e.g.
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
# Realtime Database URL for the Admin SDK (same value as the public one).
FIREBASE_ADMIN_DATABASE_URL=

# -----------------------------------------------------------------------------
# File storage — Supabase Storage.
#
# Firebase Storage needs the paid Blaze plan; Authentication and the Realtime
# Database do not. Files therefore live in Supabase, and Firebase remains the
# identity provider only. Nothing here touches sessions.
#
# Create the bucket first: Supabase -> Storage -> New bucket. Tick PUBLIC —
# a school logo has to load on the sign-in page, before anyone has
# authenticated.
# -----------------------------------------------------------------------------
# Project URL. Supabase -> Project Settings -> Data API -> Project URL.
# Format: https://<project-ref>.supabase.co   (https, no trailing slash)
SUPABASE_URL=
# Supabase -> Project Settings -> API keys -> service_role. NOT the anon key.
# Server-only: this bypasses every Storage policy, so it must never be given a
# NEXT_PUBLIC_ prefix, which would inline it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name exactly as created. Defaults to "school-files" when unset.
SUPABASE_STORAGE_BUCKET=school-files

# -----------------------------------------------------------------------------
# Database — Neon serverless PostgreSQL.
# Use the POOLED connection string (host contains "-pooler") for the app.
# Format: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Apex domain that school subdomains hang off, e.g. platform.com
# `beaconhouse.platform.com` -> subdomain "beaconhouse".
NEXT_PUBLIC_APP_DOMAIN=platform.com
# Optional. In local development there is no real subdomain, so middleware falls
# back to this location_id. Leave blank in production.
DEV_FALLBACK_LOCATION_ID=

# -----------------------------------------------------------------------------
# GoHighLevel (GHL) — OAuth app credentials.
# Marketplace -> My Apps -> your app -> Settings.
# The GHL Location ID of a sub-account is this platform's tenant identifier.
# -----------------------------------------------------------------------------
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the GHL marketplace app.
GHL_REDIRECT_URI=
# Override only if GHL changes their API host.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL API version header value (they pin behaviour by date).
GHL_API_VERSION=2021-07-28

# -----------------------------------------------------------------------------
# Encryption — AES-256-GCM key used to encrypt GHL tokens at rest.
# Must be 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored GHL token (schools must re-connect).
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Super Admin — the platform operator account.
# This is a single credential, separate from Firebase: the Super Admin works
# across every school and so has no tenant of their own.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
# bcrypt hash of the password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
SUPER_ADMIN_PASSWORD_HASH=
# Secret used to sign the 8-hour session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPER_ADMIN_JWT_SECRET=

# -----------------------------------------------------------------------------
# School portals (Sprint 3)
# One Firebase project serves every school; tenants are separated by the
# locationId custom claim, not by project.
# -----------------------------------------------------------------------------
# Base64 of the whole service-account JSON. Preferred over the three
# FIREBASE_ADMIN_* variables above; either form works.
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Apex domain that school subdomains hang off, e.g. beaconhouse.platform.com
PLATFORM_BASE_DOMAIN=platform.com
# Origin used to build invite links. In development this is your local origin.
INVITE_LINK_BASE_URL=https://platform.com

# Session cookie for the school portals. Firebase caps the lifetime at 14 days.
SCHOOL_SESSION_COOKIE_NAME=school_session
SCHOOL_SESSION_EXPIRY_DAYS=14

# -----------------------------------------------------------------------------
# GoHighLevel — agency-level key, used to send WhatsApp invitations.
# Broader than the per-school OAuth tokens above, because an invite may need to
# go out before a school has completed its own GHL install.
# -----------------------------------------------------------------------------
GHL_AGENCY_API_KEY=
GHL_WHATSAPP_INVITE_TEMPLATE=staff_invite

# -----------------------------------------------------------------------------
# Admissions (Sprint 4)
# -----------------------------------------------------------------------------
# Optional. GHL workflow triggered for the primary guardian when a student is
# enrolled. Leave blank to skip it — enrolment never depends on the workflow,
# and a missing id is logged rather than treated as an error.
GHL_ADMISSION_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# Email authentication.
#
# No new credentials are needed. Transactional mail (invitations, sign-in codes,
# password resets) goes out through each school's own GHL sub-account using the
# OAuth token already stored for it, so every school sends from its own
# white-label domain with no per-school configuration here.
#
# Two variables that already exist are load-bearing for it:
#
#   NEXT_PUBLIC_APP_URL  — origin used to build invitation links. Falls back to
#                          INVITE_LINK_BASE_URL, then to http://localhost:3000.
#   NEXT_PUBLIC_FIREBASE_API_KEY (above) — the server exchanges a Firebase
#                          custom token for an ID token through the Identity
#                          Toolkit REST API, which needs the Web API key. Set
#                          FIREBASE_WEB_API_KEY to override it separately.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://platform.com
# Optional. Defaults to NEXT_PUBLIC_FIREBASE_API_KEY.
FIREBASE_WEB_API_KEY=

# -----------------------------------------------------------------------------
# SMTP — the email fallback when WhatsApp cannot deliver an invitation.
# Leave blank to disable email entirely; invitations then require WhatsApp.
#
# WhatsApp auth temporarily disabled - re-enable when Meta template approved.
# These stay set: `lib/invite-sender.ts` still uses them for the WhatsApp invite
# flow's email fallback, which is untouched.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# One-time passcodes sent over WhatsApp. Codes are six digits, so the expiry
# and attempt cap are what keep them safe — do not raise them casually.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# GoHighLevel — OAuth install (the "Connect GoHighLevel" button on a school).
#
# GHL_REDIRECT_URI above must point at /api/ghl/callback on this deployment and
# match the marketplace app's registered redirect URI byte for byte — GHL
# compares it as a string, so a trailing slash is a different URI. For example:
#   https://platform.com/api/ghl/callback
#
# Scopes must be a subset of what the marketplace app is registered with, or GHL
# refuses the consent screen. Leave blank to use the defaults in
# lib/ghl-oauth.ts, which are exactly what this application calls:
#   contacts.readonly contacts.write conversations.readonly conversations.write
#   conversations/message.readonly conversations/message.write locations.readonly
# -----------------------------------------------------------------------------
GHL_OAUTH_SCOPES=
# Override only if GHL changes their marketplace host.
GHL_MARKETPLACE_URL=https://marketplace.gohighlevel.com
